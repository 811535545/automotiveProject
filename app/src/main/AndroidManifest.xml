<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 宣告车载系统硬件特性 -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />

    <!-- AAOS 车规级开机自启权限 -->
    <uses-permission android:name="android.intent.action.BOOT_COMPLETED" />
    <uses-permission android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />

    <!--
      AAOS 原生通道系统级权限宣告。
      注：在系统级 privileged app 或签名匹配的 AAOS 系统镜像上，可直接获得车辆控制权。
    -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="android.car.permission.CAR_ENERGY" />
    <uses-permission android:name="android.car.permission.CAR_CLIMATE" />
    <uses-permission android:name="android.car.permission.CAR_CONTROL_AUDIO_SETTINGS" />
    <uses-permission android:name="android.car.permission.CAR_UX_RESTRICTIONS_EXEMPT" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="AAOS Middleware"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <!-- 普通设备没有该 shared library；required=false 保证仍可安装并走 Mock 通道 -->
        <uses-library
            android:name="android.car"
            android:required="false" />

        <!-- 注册座舱中间件开机自启广播接收器 -->
        <receiver
            android:name="com.oem.car.core.vehicleservice.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
